# ─── 1. Database (PostgreSQL or MySQL/TiDB) ───────────────────────────────
# Razorpay runs MySQL historically and PostgreSQL / Aurora PostgreSQL for
# newer transactional systems, so this project supports both. The driver is
# inferred from the URL scheme; DATABASE_DRIVER only overrides it.
#
# PostgreSQL (Supabase: Settings -> Database -> Connection string -> URI):
#   DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres
# MySQL / TiDB Serverless:
#   DATABASE_URL=mysql://user:PASSWORD@gateway.tidbcloud.com:4000/revenue_recovery
#
# Then run the matching schema against it:
#   db/schema.postgres.sql   or   db/schema.mysql.sql
DATABASE_URL=
DATABASE_DRIVER=

# Razorpay test mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# base64(RAZORPAY_KEY_ID:RAZORPAY_KEY_SECRET) — generate with:
#   echo $RAZORPAY_KEY_ID:$RAZORPAY_KEY_SECRET | base64
RAZORPAY_MCP_MERCHANT_TOKEN=

# WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# WhatsApp Business Account id (WhatsApp Manager → Account tools → not the app id).
# Optional, but with it preflight checks the template's approval status AND that
# its body has exactly the two variables lib/whatsapp.ts sends.
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Send safety — the synthetic batch uses plausible REAL Indian mobile numbers.
# Set one of these before seeding against live credentials, or the pipeline
# will message real strangers.
#   # The approved template's name and language. Both matter: a template
# approved as en_US and sent as `en` fails with an error that names neither,
# and re-approval takes hours. Check them in WhatsApp Manager before a demo.
WHATSAPP_TEMPLATE_NAME=payment_retry_nudge
WHATSAPP_TEMPLATE_LANG=en

WHATSAPP_DRY_RUN=true        -> log instead of sending (safest for demos)
#   WHATSAPP_TEST_RECIPIENT=+91... -> redirect every send to your own number
WHATSAPP_DRY_RUN=true
WHATSAPP_TEST_RECIPIENT=

# Agent — set EITHER of these. Anthropic wins when both are present.
# Optional DECISION_MODEL overrides the model id for whichever provider is used.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DECISION_MODEL=

# Batch seeding
WEBHOOK_URL=http://localhost:3000/api/webhooks/razorpay
